@model DailyTrackingSystem.Models.Spending

@{
    ViewData["Title"] = "Harcama Ekle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                @* Başlık Alanı: Dark Mode ve Beyaz Yazı *@
                <div class="card-header bg-dark text-white p-3 text-center">
                    <h4 class="mb-0 fw-bold">Harcama Ekle</h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="CreateSpending" method="post">

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Açıklama</label>
                            <input asp-for="Description" class="form-control form-control-lg border-2" placeholder="Harcama açıklaması..." />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-bold">Tutar</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold">₺</span>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control form-control-lg border-2" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Date" class="form-label fw-bold">Tarih</label>
                            <input asp-for="Date" type="date" class="form-control form-control-lg border-2" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Kategori</label>
                            @Html.DropDownListFor(x => x.CategoryId, (List<SelectListItem>)ViewBag.vls, "Kategori Seçiniz!", new { @class = "form-select form-select-lg border-2" })
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            @* Kaydet Butonu: Yeşil ve İkonlu *@
                            <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm">
                                <i class="bi bi-check-circle me-1"></i> Kaydet
                            </button>

                            @* Geri Dön Butonu: Koyu Çerçeveli ve İkonlu *@
                            <a asp-action="Index" class="btn btn-outline-dark fw-semibold">
                                <i class="bi bi-arrow-left-circle me-1"></i> Geri Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>