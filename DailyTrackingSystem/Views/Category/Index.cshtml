@model List<DailyTrackingSystem.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Kategori Listesi</h2>
        <a href="/Category/CreateCategory" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle"></i> Kategori Ekle
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">Numara</th>
                        <th>Kategori</th>
                        <th class="text-center">Durum</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center align-middle">@item.Id</td>
                            <td class="align-middle fw-bold">@item.Name</td>
                            <td class="text-center align-middle">
                                <span class="badge rounded-pill @(item.Status ? "bg-success" : "bg-secondary")">
                                    @(item.Status ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-center align-middle">
                                <div class="btn-group" role="group">
                                    <a href="/Category/UpdateCategory/@item.Id"
                                       class="btn btn-outline-warning btn-sm mx-1">
                                        <i class="bi bi-pencil"></i> Güncelle
                                    </a>
                                    <a href="/Category/DeleteCategory/@item.Id"
                                       class="btn btn-outline-danger btn-sm mx-1"
                                       onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?')">
                                        <i class="bi bi-trash"></i> Sil
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>